{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HireFerry",
  "version": "0.1.0",
  "identifier": "best.lmm.hireferry",
  "mainBinaryName": "hireferry-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["launcher"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "publisher": "HireFerry",
    "homepage": "https://hireferry.lmm.best",
    "shortDescription": "People and opportunities, connected.",
    "longDescription": "HireFerry is a lightweight desktop client for the HireFerry recruitment platform. Connect to the official service or your own deployment.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "displayLanguageSelector": false
      }
    },
    "macOS": { "minimumSystemVersion": "11.0" },
    "linux": {
      "deb": { "section": "net" },
      "rpm": { "compression": { "type": "xz", "level": 6 } },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
