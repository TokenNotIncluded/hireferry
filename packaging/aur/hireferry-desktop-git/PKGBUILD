# Maintainer: HireFerry contributors <support@lmm.best>
# Generated by scripts/aur.py; edit the generator in the upstream repository.
pkgname=hireferry-desktop-git
pkgver=0.1.0.r1.g16ceda1
pkgrel=1
pkgdesc='HireFerry desktop workspace, built with Tauri and the system WebView'
arch=('x86_64' 'aarch64')
url='https://github.com/TokenNotIncluded/hireferry'
license=('AGPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'openssl' 'ca-certificates' 'gtk3' 'webkit2gtk-4.1' 'libsoup3' 'hicolor-icon-theme' 'desktop-file-utils' 'xdg-utils')
provides=('hireferry-desktop')
conflicts=('hireferry-desktop')
makedepends=('cargo' 'git' 'pkgconf')
options=('!lto')
source=('hireferry::git+https://github.com/TokenNotIncluded/hireferry.git#branch=main')
sha256sums=('SKIP')
_target="$CARCH-unknown-linux-gnu"

pkgver() {
  cd "$srcdir/hireferry"
  local version
  version=$(sed -n 's/^version = "\([^"]*\)"$/\1/p' desktop/src-tauri/Cargo.toml | head -n 1)
  printf '%s.r%s.g%s' "${version//-/.}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/hireferry"
  cargo fetch --locked --target "$_target" --manifest-path desktop/src-tauri/Cargo.toml
}

build() {
  cd "$srcdir/hireferry"
  CARGO_TARGET_DIR=target cargo build --frozen --release --target "$_target" --manifest-path desktop/src-tauri/Cargo.toml --bin hireferry-desktop --features custom-protocol
}

check() {
  cd "$srcdir/hireferry"
  CARGO_TARGET_DIR=target cargo test --frozen --target "$_target" --manifest-path desktop/src-tauri/Cargo.toml --bin hireferry-desktop --features custom-protocol
}

package() {
  cd "$srcdir/hireferry"
  install -Dm755 target/$_target/release/hireferry-desktop "$pkgdir/usr/bin/hireferry-desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/flatpak/best.lmm.hireferry.desktop "$pkgdir/usr/share/applications/best.lmm.hireferry.desktop"
  install -Dm644 desktop/src-tauri/icons/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/best.lmm.hireferry.svg"
  install -Dm644 docs/desktop.md "$pkgdir/usr/share/doc/hireferry-desktop/README.md"
}
